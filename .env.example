# Copy to .env (never commit real values). All values below are safe local defaults.
PORT=4000
# Loopback only by default. Set HOST=0.0.0.0 ONLY on a trusted LAN (see docs/ARCHITECTURE.md, "Multi-terminal").
HOST=127.0.0.1
SUPERMART_DB=./data/supermart.db
# basic | inventory | full  (used only when the database is created for the first time)
SUPERMART_EDITION=full
# Frontend (Expo dev server) -> API base URL. Empty = same origin (production build served by the API server).
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
